{
  "version": 1,
  "initial": { "x": 0, "y": 0 },
  "elements": [
    {
      "name": "Open",
      "x": 0,
      "y": 0,
      "width": 140,
      "height": 60
    },
    {
      "name": "Closed",
      "x": 300,
      "y": 0,
      "width": 140,
      "height": 60,
      "transitions": [
        {
          "trigger": "lock, after(1.5s)",
          "target": "Locked",
          "label": { "x": 0, "y": 0 }
        }
      ]
    },
    {
      "name": "Locked",
      "x": 300,
      "y": 200,
      "width": 140,
      "height": 60
    }
  ]
}
