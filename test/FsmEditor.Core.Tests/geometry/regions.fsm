            { "name": "S1", "type": "state" }
          ]
        },
        {
          "name": "middle",
          "elements": [
            { "name": "S2", "type": "state" }
          ]
        },
        {
          "name": "bottom",
          "elements": [
            { "name": "S3", "type": "state" }
          ]
        }
      ]
    },
    {
      "name": "Side",
      "type": "state",
      "regions": [
        {
          "name": "region1*",
          "elements": [
            { "name": "H1", "type": "state" }
          ]
        },
        {
          "name": "region2*",
          "elements": [
            { "name": "H2", "type": "state" }
          ]
        }
      ]
    },
    {
