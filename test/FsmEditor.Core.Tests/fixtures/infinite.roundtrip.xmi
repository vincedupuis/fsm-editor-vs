<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="20131001" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:uml="http://www.omg.org/spec/UML/20161101" xmlns:umldi="http://www.omg.org/spec/UML/20161101/UMLDI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <uml:Model xmi:id="sm_model" name="Infinite">
    <packagedElement xmi:type="uml:StateMachine" xmi:id="sm" name="Infinite">
      <region xmi:type="uml:Region" xmi:id="r">
        <subvertex xmi:type="uml:Pseudostate" xmi:id="i" kind="initial"/>
        <subvertex xmi:type="uml:State" xmi:id="A" name="A"/>
        <subvertex xmi:type="uml:State" xmi:id="B" name="B"/>
        <transition xmi:type="uml:Transition" xmi:id="t0" kind="external" source="i" target="A"/>
        <transition xmi:type="uml:Transition" xmi:id="t1" kind="external" source="A" target="B">
          <trigger xmi:type="uml:Trigger" xmi:id="t1_trigger1" name="go" event="ev_go"/>
        </transition>
        <transition xmi:type="uml:Transition" xmi:id="t2" kind="external" source="B" target="A">
          <trigger xmi:type="uml:Trigger" xmi:id="t2_trigger1" name="back" event="ev_back"/>
        </transition>
        <transition xmi:type="uml:Transition" xmi:id="t3" kind="external" source="A" target="A">
          <trigger xmi:type="uml:Trigger" xmi:id="t3_trigger1" name="tick" event="ev_tick"/>
        </transition>
      </region>
    </packagedElement>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_go" name="go" signal="sig_go"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_go" name="go"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_back" name="back" signal="sig_back"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_back" name="back"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_tick" name="tick" signal="sig_tick"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_tick" name="tick"/>
  </uml:Model>
  <umldi:UMLStateMachineDiagram xmi:id="sm_diagram" name="Infinite" modelElement="sm" isFrame="false">
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_i" modelElement="i">
      <bounds xmi:type="dc:Bounds" x="20" y="40" width="20" height="20"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_A" modelElement="A">
      <bounds xmi:type="dc:Bounds" x="80" y="20" width="140" height="60"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_B" modelElement="B">
      <bounds xmi:type="dc:Bounds" x="400" y="20" width="140" height="60"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t0" modelElement="t0" source="di_i" target="di_A">
      <waypoint xmi:type="dc:Point" x="30" y="50"/>
      <waypoint xmi:type="dc:Point" x="150" y="50"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t1" modelElement="t1" source="di_A" target="di_B">
      <waypoint xmi:type="dc:Point" x="150" y="50"/>
      <waypoint xmi:type="dc:Point" x="0" y="150"/>
      <waypoint xmi:type="dc:Point" x="470" y="50"/>
      <ownedElement xmi:type="umldi:UMLLabel" xmi:id="di_t1_label" modelElement="t1">
        <bounds xmi:type="dc:Bounds" x="96.8" y="110.8" width="100" height="16"/>
      </ownedElement>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t2" modelElement="t2" source="di_B" target="di_A">
      <waypoint xmi:type="dc:Point" x="470" y="50"/>
      <waypoint xmi:type="dc:Point" x="300" y="0"/>
      <waypoint xmi:type="dc:Point" x="0" y="-60"/>
      <waypoint xmi:type="dc:Point" x="150" y="50"/>
      <ownedElement xmi:type="umldi:UMLLabel" xmi:id="di_t2_label" modelElement="t2">
        <bounds xmi:type="dc:Bounds" x="95.7" y="-38.9" width="100" height="16"/>
      </ownedElement>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t3" modelElement="t3" source="di_A" target="di_A">
      <waypoint xmi:type="dc:Point" x="150" y="50"/>
      <waypoint xmi:type="dc:Point" x="250" y="-10"/>
      <waypoint xmi:type="dc:Point" x="150" y="50"/>
      <ownedElement xmi:type="umldi:UMLLabel" xmi:id="di_t3_label" modelElement="t3">
        <bounds xmi:type="dc:Bounds" x="200" y="-13" width="100" height="16"/>
      </ownedElement>
    </ownedElement>
  </umldi:UMLStateMachineDiagram>
</xmi:XMI>
