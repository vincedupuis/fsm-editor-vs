<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FsmEditor.Core\FsmEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\examples\*.fsm" LinkBase="examples" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\examples\*.fsm.layout" LinkBase="examples" CopyToOutputDirectory="PreserveNewest" />
    <!-- fsm-editor-common's sidecar and its interface's cases, copied into the VSIX project's cli/ by scripts/fetch-common.sh. -->
    <None Include="..\..\src\FsmEditor.Vsix\cli\fsm-editor-common*" LinkBase="cli" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\FsmEditor.Vsix\cli\api-cases\**" LinkBase="api-cases" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\examples\*.log" LinkBase="examples" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\FsmEditor.Vsix\ItemTemplates\StateMachine\StateMachine.fsm" Link="templates\StateMachine.fsm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\FsmEditor.Vsix\ItemTemplates\StateMachine\StateMachine.fsm.layout" Link="templates\StateMachine.fsm.layout" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
