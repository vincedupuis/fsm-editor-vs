<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests inside Visual Studio: they start devenv (the experimental instance, /rootsuffix Exp, where the workflow
    installs the VSIX), drive it through DTE and real input, and look at it through UI Automation. Windows only, and
    only when FSM_VS_INTEGRATION=1 (integration.yml on the self-hosted runner); elsewhere they are skipped.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <!-- A .NET Framework test host is Windows only: elsewhere, dotnet test passes this project by. -->
    <IsTestProject Condition="'$(OS)' != 'Windows_NT'">false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="EnvDTE" Version="17.14.40260" />
    <PackageReference Include="EnvDTE80" Version="17.14.40260" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\examples\*.fsm" LinkBase="examples" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\examples\*.fsm.layout" LinkBase="examples" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
