<Project>

  <!-- Explicit SDK imports: the VSSDK targets must be imported after the .NET SDK targets (see the end). -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <!--
    Visual Studio 2022+ extension (VSIX). On Windows, building produces
    bin/<Configuration>/net48/FsmEditor.vsix; F5 starts the experimental instance.
    On other systems the VSSDK build tools are skipped, so `dotnet build`
    only compiles the code (useful to type-check it).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FsmEditor</RootNamespace>
    <AssemblyName>FsmEditor</AssemblyName>
    <Version>0.7.1</Version>
    <IsWindows Condition="'$(OS)' == 'Windows_NT'">true</IsWindows>

    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <VSSDKTargetPlatformRegRootSuffix>Exp</VSSDKTargetPlatformRegRootSuffix>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by Visual Studio at run time. -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.32112.339" ExcludeAssets="runtime" />
    <!-- Shipped in the VSIX. -->
    <PackageReference Include="Community.VisualStudio.Toolkit.17" Version="17.0.551" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" Condition="'$(IsWindows)' == 'true'">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FsmEditor.Core\FsmEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
    <VSCTCompile Include="VSCommandTable.vsct" ResourceName="Menus.ctmenu" Condition="'$(IsWindows)' == 'true'" />
    <None Include="VSCommandTable.vsct" Condition="'$(IsWindows)' != 'true'" />
    <EmbeddedResource Update="VSPackage.resx" MergeWithCTO="true" ManifestResourceName="VSPackage" />
    <Content Include="Resources\icon.png" IncludeInVSIX="true" />
    <Content Include="Resources\LICENSE.txt" IncludeInVSIX="true" />
  </ItemGroup>

  <!--
    The State Machine item template, zipped once per project type by ZipItemTemplates
    (File › New › File and Add › New Item list templates by project type).
  -->
  <PropertyGroup>
    <ItemTemplatesDir>$(BaseIntermediateOutputPath)ItemTemplates\</ItemTemplatesDir>
  </PropertyGroup>
  <ItemGroup>
    <ItemTemplateProjectType Include="General;CSharp;VisualBasic;VC" />
    <Content Include="$(ItemTemplatesDir)General\StateMachine.zip" IncludeInVSIX="true" VSIXSubPath="ItemTemplates\General" />
    <Content Include="$(ItemTemplatesDir)CSharp\StateMachine.zip" IncludeInVSIX="true" VSIXSubPath="ItemTemplates\CSharp" />
    <Content Include="$(ItemTemplatesDir)VisualBasic\StateMachine.zip" IncludeInVSIX="true" VSIXSubPath="ItemTemplates\VisualBasic" />
    <Content Include="$(ItemTemplatesDir)VC\StateMachine.zip" IncludeInVSIX="true" VSIXSubPath="ItemTemplates\VC" />
  </ItemGroup>
  <Target Name="ZipItemTemplates" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_StateMachineVstemplate>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\ItemTemplates\StateMachine\StateMachine.vstemplate'))</_StateMachineVstemplate>
    </PropertyGroup>
    <Copy SourceFiles="ItemTemplates\StateMachine\StateMachine.fsm;ItemTemplates\StateMachine\StateMachine.fsm.layout;Resources\icon.png" DestinationFolder="$(ItemTemplatesDir)%(ItemTemplateProjectType.Identity)\files" />
    <WriteLinesToFile File="$(ItemTemplatesDir)%(ItemTemplateProjectType.Identity)\files\StateMachine.vstemplate"
                      Lines="$([MSBuild]::Escape($(_StateMachineVstemplate.Replace('@ProjectType@', '%(ItemTemplateProjectType.Identity)'))))"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ZipDirectory SourceDirectory="$(ItemTemplatesDir)%(ItemTemplateProjectType.Identity)\files"
                  DestinationFile="$(ItemTemplatesDir)%(ItemTemplateProjectType.Identity)\StateMachine.zip" Overwrite="true" />
  </Target>

  <!--
    fsm-editor-common's sidecar (github.com/vincedupuis/fsm-editor-common), which reads, writes, converts, validates,
    compares and merges the machines and generates their code, with fsm-cli's templates and the files' JSON Schemas:
    the windows-x64 and templates/schemas archives of an fsm-editor-common release, copied into cli/ by
    scripts/fetch-common.ps1 or scripts/fetch-common.sh (the release workflow downloads the one pinned by
    FSM_COMMON_VERSION). The interface's cases (cli/api-cases) are for the Core tests only.
  -->
  <ItemGroup>
    <Content Include="cli\**\*" Exclude="cli\api-cases\**;cli\fsm-editor-common;cli\schemas\api.schema.json" IncludeInVSIX="true" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The extension can't work without the sidecar: a Release build requires it; Debug builds only warn. -->
  <Target Name="WarnMissingCommon" BeforeTargets="Build" Condition="!Exists('cli\fsm-editor-common.exe') And '$(Configuration)' != 'Release'">
    <Warning Text="cli\fsm-editor-common.exe is missing: run scripts\fetch-common.ps1 (or scripts/fetch-common.sh) so the VSIX bundles fsm-editor-common, without which the editor can't read or write machines." />
  </Target>
  <Target Name="RequireCommonForRelease" BeforeTargets="Build" Condition="!Exists('cli\fsm-editor-common.exe') And '$(Configuration)' == 'Release' And '$(IsWindows)' == 'true'">
    <Error Text="cli\fsm-editor-common.exe is missing: run scripts\fetch-common.ps1 before a Release build, so the published VSIX bundles fsm-editor-common." />
  </Target>


  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <!--
    The VSIX build (command table, pkgdef, .vsix container). Microsoft.VSSDK.BuildTools
    only sets VSToolsPath; the project imports the targets itself.
  -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(IsWindows)' == 'true' And Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
  <Target Name="CheckVsSdkTargets" BeforeTargets="Build" Condition="'$(IsWindows)' == 'true' And !Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')">
    <Error Text="The VSSDK build targets were not found under '$(VSToolsPath)'. Restore the Microsoft.VSSDK.BuildTools package (or install the Visual Studio extension development workload)." />
  </Target>

</Project>
