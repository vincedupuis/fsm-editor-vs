<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="FsmEditor.VisualStudio.43c53194-4f12-42ec-8fcc-0bbca916caaf" Version="0.3.5" Language="en-US" Publisher="Vincent Dupuis" />
    <DisplayName>FSM Editor and Codegen for Visual Studio</DisplayName>
    <Description xml:space="preserve">Visual editor and code generator for UML 2.5.1 state machines: draw composite/orthogonal states, submachines with connection point references, all pseudostates and protocol state machines, then generate source code from Handlebars templates (TypeScript bundled) with the bundled fsm generator, which also runs from a terminal or a build. Stored as standard XMI with UML DI layout, with validation in the Error List and SVG export.</Description>
    <MoreInfo>https://github.com/vincedupuis/fsm-editor-vs</MoreInfo>
    <License>Resources\LICENSE.txt</License>
    <Icon>Resources\icon.png</Icon>
    <Tags>uml;state machine;fsm;statechart;diagram;xmi;umldi;code generation;code generator;handlebars</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, 19.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.8,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
